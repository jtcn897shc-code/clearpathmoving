---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo-nav.png";
import Icon from "./Icon.astro";
import { nav, tel, business } from "../data/site";
---
<header class="nav" data-nav>
  <div class="wrap nav__in">
    <a href="#top" class="nav__logo" aria-label={`${business.name}, back to top`}>
      <Image src={logo} alt="" width={124} height={49} densities={[1, 2]} loading="eager" />
    </a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn nav__call" href={tel}><Icon name="phone" /><span>{business.phoneDisplay}</span></a>
  </div>
</header>
<script>
  const navEl = document.querySelector<HTMLElement>("[data-nav]")!;
  const onScroll = () => navEl.classList.toggle("is-scrolled", window.scrollY > 24);
  onScroll(); addEventListener("scroll", onScroll, { passive: true });
</script>
<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; transition: background-color var(--d-ui) ease, border-color var(--d-ui) ease; border-bottom: 1px solid transparent; }
  .nav.is-scrolled { background: var(--ink); border-color: var(--line); }
  .nav__in { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); height: 76px; }
  .nav__logo img { width: auto; height: 46px; }
  .nav__links { display: flex; gap: var(--s-6); font-size: var(--t-sm); font-weight: 600; }
  .nav__links a { text-decoration: none; color: var(--muted); transition: color var(--d-ui) ease; }
  @media (hover: hover) and (pointer: fine) { .nav__links a:hover { color: var(--paper); } }
  .nav__call { min-height: 44px; }
  @media (max-width: 900px) { .nav__links { display: none; } }
  @media (max-width: 480px) { .nav__call span { display: none; } .nav__call { padding: 0 0.9em; } .nav__call::after { content: "Call"; } }
</style>
