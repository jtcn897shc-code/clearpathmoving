---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { hero, tel, sms, business } from "../data/site";
import { images } from "../data/images";
---
<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <Image src={images.hero.src!} alt="" widths={[640, 1024, 1344]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="wrap hero__in">
    <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="display hero__title">
      {hero.headline.map((w, i) => <span class="hero__word" style={`--i:${i}`}><span>{w}</span></span>)}
    </h1>
    <p class="hero__sub">{hero.sub}</p>
    <div class="hero__ctas">
      <a class="btn" href="#quote">{hero.primaryCta}<Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={sms("Hi Muhammed, I'd like a quote for ")}><Icon name="chat" />Text {business.phoneDisplay}</a>
    </div>
    <p class="hero__hours"><Icon name="clock" /> Open {business.hours.short}</p>
  </div>
</section>
<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; padding: 140px 0 var(--s-9); overflow: hidden; isolation: isolate; text-align: center; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(14 13 12 / .55) 0%, rgb(14 13 12 / .35) 40%, var(--ink) 100%); }
  .hero__in { display: grid; justify-items: center; gap: var(--s-5); }
  .hero__title { font-size: var(--t-hero); display: flex; flex-wrap: wrap; justify-content: center; gap: 0 0.25em; }
  .hero__word { display: inline-block; overflow: clip; padding-bottom: 0.04em; }
  .hero__word:nth-child(3) { color: var(--orange); }
  .hero__sub { max-width: 46ch; font-size: var(--t-lg); color: color-mix(in srgb, var(--paper) 86%, transparent); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); justify-content: center; }
  .hero__hours { display: inline-flex; gap: 0.5em; align-items: center; font-size: var(--t-sm); color: var(--muted); }
  .hero__hours .icon { width: 1.1em; color: var(--yellow); }
  .js .hero__word > span { display: inline-block; animation: rise 900ms var(--ease-out) both; animation-delay: calc(150ms + var(--i) * 110ms); }
  @keyframes rise { from { transform: translateY(105%); } }
  @media (prefers-reduced-motion: reduce) { .js .hero__word > span { animation: fade 400ms ease both; } @keyframes fade { from { opacity: 0; } } }
</style>
